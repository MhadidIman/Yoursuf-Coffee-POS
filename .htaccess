<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Blokir akses langsung ke file sensitif (.env, .git, composer, sql, artisan)
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml) - [F,L,NC]
    RewriteRule ^database/.*\.sql$ - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)/ - [F,L,NC]

    # 2. Arahkan seluruh request dari Domain Utama (public_html) ke folder public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

# Nonaktifkan directory listing demi keamanan di cPanel Hosting
Options -Indexes
